TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_STRING_SESSION=
ALLOWED_USERS=
DATA_ROOT=/data
DASHBOARD_PASSWORD=
DASHBOARD_SECRET=
PASSWORD_ENCRYPTION_KEY=
FINGERPRINT_KEY=
HOST=0.0.0.0
PORT=8000
# 0 = unlimited (recommended). Per-file cap only; not a sum across albums.
MAX_DOWNLOAD_BYTES=0
# 0 = unlimited expanded size (recommended for large log packs). Free disk is the hard stop.
MAX_EXPANDED_BYTES=0
# 0 = unlimited file count inside archives (recommended). Free disk is the hard stop.
MAX_ARCHIVE_FILES=0
# 0 = unlimited per-file scan size (recommended for large text/log dumps).
MAX_SCAN_FILE_BYTES=0
MAX_NESTING_DEPTH=3
MIN_FREE_BYTES=1073741824
EXTRACTION_TIMEOUT_SECONDS=1800
EXTRACTION_WORKERS=1
# Parallel Telegram downloads (1-16). Start with 3 to limit flood-waits/disk pressure.
INGEST_WORKERS=10
LOG_LEVEL=INFO
# Telegram bot delivery of extracted keys is disabled. Results stay on the dashboard.
# CRED_ALERT_BOT_TOKEN=
# CRED_ALERT_CHAT_ID=
# Optional Railway auto-redeploy after session regenerate:
# RAILWAY_API_TOKEN=
# RAILWAY_SERVICE_ID=
